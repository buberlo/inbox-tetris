# Inbox Tetris environment variables
#
# Copy this file to .env.local and fill in the values you need.
# The app runs in mock mode by default, so no external mail setup is required.

# Provider: mock | gmail | imap
EMAIL_PROVIDER=mock

# Optional public base URL for API calls.
# Leave as /api for same-origin Next.js API routes.
NEXT_PUBLIC_API_BASE_URL=/api

# ---------------------------------------------------------------------------
# Mock provider
# ---------------------------------------------------------------------------
# Number of unread emails to generate in mock mode.
MOCK_EMAIL_COUNT=24

# Optional deterministic seed for mock email generation.
MOCK_SEED=1

# Maximum age, in days, for generated mock emails.
MOCK_MAX_AGE_DAYS=14

# Rough priority distribution for mock emails.
# Format: low:percent,medium:percent,high:percent
MOCK_PRIORITY_DISTRIBUTION=low:40,medium:40,high:20

# ---------------------------------------------------------------------------
# Gmail provider
# ---------------------------------------------------------------------------
# OAuth client credentials from Google Cloud Console.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# OAuth redirect URI registered in Google Cloud Console.
GMAIL_REDIRECT_URI=http://localhost:3000/api/auth/gmail/callback

# Gmail API scope. Use gmail.modify if archiving, labeling, or starring.
GMAIL_SCOPE=https://www.googleapis.com/auth/gmail.modify

# Refresh token from the OAuth flow.
GMAIL_REFRESH_TOKEN=

# Gmail account to read from.
GMAIL_ACCOUNT=you@example.com

# How many unread messages to fetch per API page.
GMAIL_PAGE_SIZE=50

# Comma-separated Gmail labels considered part of the playable inbox.
GMAIL_LABELS=INBOX,IMPORTANT,STARRED

# Comma-separated Gmail labels that mark an email as high priority.
GMAIL_PRIORITY_LABELS=IMPORTANT

# Comma-separated Gmail labels that should be ignored by the board.
GMAIL_IGNORE_LABELS=SPAM,TRASH

# Comma-separated Gmail labels removed when an email is archived.
GMAIL_ARCHIVE_LABELS=STARRED,IMPORTANT

# ---------------------------------------------------------------------------
# IMAP provider
# ---------------------------------------------------------------------------
# IMAP server host, for example imap.gmail.com or mail.example.com.
IMAP_HOST=

# IMAP port. Use 993 for IMAPS.
IMAP_PORT=993

# Set to true when using IMAPS/TLS.
IMAP_SECURE=true

# IMAP username and password.
IMAP_USER=
IMAP_PASSWORD=

# Folder to read unread messages from.
IMAP_FOLDER=INBOX

# How many unread messages to fetch per IMAP page.
IMAP_PAGE_SIZE=50

# Optional sender prefixes that indicate high priority.
# Example: boss@example.com,alerts@example.com
IMAP_PRIORITY_FROM=

# Optional sender prefixes that indicate low priority.
IMAP_PRIORITY_TO=

# Optional label prefix used when applying labels through IMAP.
IMAP_LABEL_PREFIX=

# Folder to move messages to when archiving, if supported.
IMAP_ARCHIVE_FOLDER=Archive

# Comma-separated folders ignored by the board.
IMAP_IGNORE_FOLDERS=Trash,Spam

# ---------------------------------------------------------------------------
# Focus meter tuning
# ---------------------------------------------------------------------------
# Focus lost per tick while the unread stack is in the danger zone.
FOCUS_DECAY_PER_TICK=1

# Stack height threshold, in rows, where the danger zone begins.
FOCUS_DANGER_THRESHOLD=70

# Focus recovered when a line is cleared.
FOCUS_RECOVER_PER_CLEAR=10

# Maximum focus value.
FOCUS_MAX=100

# ---------------------------------------------------------------------------
# Daily replay
# ---------------------------------------------------------------------------
# Time zone used to calculate the daily replay window.
REPLAY_TIMEZONE=UTC

# Maximum number of cleared lines included in the replay summary.
REPLAY_MAX_CLEARED_LINES=100

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# Server-side log level: debug | info | warn | error
LOG_LEVEL=info